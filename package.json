{
	"name": "obsidian-sigilizer",
	"version": "0.1.0",
	"description": "Turn intentions into sigils inscribed in a magic circle, and export them as PNGs.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "0.20.2",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5",
		"vitest": "^1.6.0"
	}
}
